# Copy to .env (docker compose) or export in your shell. All settings are prefixed SENTINAI_.
SENTINAI_ENVIRONMENT=development
SENTINAI_DATABASE_URL=sqlite:///./data/sentinai.db
# SENTINAI_DATABASE_URL=postgresql+psycopg://sentinai:sentinai@postgres:5432/sentinai
# SENTINAI_RAW_STORE_URL=mongodb://mongo:27017
SENTINAI_JWT_SECRET=please-change-me-to-a-long-random-string-of-at-least-32-bytes
SENTINAI_SEED_DEMO_DATA=true

# Ingestion (Module 1) — App-only bearer token from developer.x.com (Project → Keys and tokens).
# Leave empty to stay in demo mode; you can also paste it in the dashboard (Ingest from X).
SENTINAI_X_BEARER_TOKEN=
# Use /2/tweets/search/all instead of /search/recent (needs full-archive access; auto-falls back)
SENTINAI_X_FULL_ARCHIVE=false
# Download photo attachments to data/media so OCR / CLIP / symbol detection can run on them
SENTINAI_X_DOWNLOAD_MEDIA=false
# Interactive (dashboard) pulls give up on a rate limit after this many seconds instead of blocking
SENTINAI_X_API_MAX_WAIT_SECONDS=45
# Event overlay (Module 8) — GDELT needs no key; NewsAPI does
SENTINAI_NEWSAPI_KEY=

# Classifier backend: heuristic (default, no downloads) | transformer (requires pip install -e ".[ml]")
SENTINAI_CLASSIFIER_BACKEND=heuristic
SENTINAI_TOXICITY_MODEL_NAME=microsoft/deberta-v3-large
SENTINAI_TARGET_MODEL_NAME=xlm-roberta-large

# Bootstrap accounts (change in production)
SENTINAI_BOOTSTRAP_ADMIN_PASSWORD=admin
SENTINAI_BOOTSTRAP_RESEARCHER_PASSWORD=researcher
SENTINAI_BOOTSTRAP_MODERATOR_PASSWORD=moderator
